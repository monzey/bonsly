+++ b/pkg/gui/presentation/openvide_test.go
@@ -0,0 +1,38 @@
+package presentation
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/gookit/color"
+	"github.com/jesseduffield/lazygit/pkg/commands/models"
+	"github.com/jesseduffield/lazygit/pkg/config"
+	"github.com/jesseduffield/lazygit/pkg/gui/types"
+	"github.com/jesseduffield/lazygit/pkg/i18n"
+	"github.com/stretchr/testify/assert"
+	"github.com/xo/terminfo"
+)
+
+func TestOpenvideRepositoryContext(t *testing.T) {
+	oldColorLevel := color.ForceSetColorLevel(terminfo.ColorLevelNone)
+	defer color.ForceSetColorLevel(oldColorLevel)
+
+	tr := &i18n.TranslationSet{}
+	worktree := &models.Worktree{Name: "feature", Branch: "feature", Path: "/repo/feature"}
+	remote := &models.Remote{Name: "origin", Urls: []string{"git@example.com:repo.git", "https://example.com/repo"}}
+	userConfig := config.GetDefaultConfig()
+
+	t.Setenv("OPENVIDE_GIT_OVERVIEW", "")
+	normalWorktree := GetWorktreeDisplayString(tr, worktree)
+	normalRemote := getRemoteDisplayStrings(remote, false, types.ItemOperationNone, tr, userConfig)
+	assert.NotContains(t, normalWorktree, worktree.Path)
+	assert.NotContains(t, normalRemote, strings.Join(remote.Urls, " | "))
+
+	t.Setenv("OPENVIDE_GIT_OVERVIEW", "1")
+	assert.Equal(t, append(normalWorktree, worktree.Path), GetWorktreeDisplayString(tr, worktree))
+	assert.Equal(t, append(normalRemote, strings.Join(remote.Urls, " | ")),
+		getRemoteDisplayStrings(remote, false, types.ItemOperationNone, tr, userConfig))
+
+	remote.Urls = nil
+	assert.Equal(t, normalRemote, getRemoteDisplayStrings(remote, false, types.ItemOperationNone, tr, userConfig))
+}
